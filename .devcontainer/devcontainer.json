{
  "name": "ClipForge browser studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "22" } },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && bash scripts/setup.sh",
  "forwardPorts": [5173],
  "portsAttributes": { "5173": { "label": "ClipForge AI", "onAutoForward": "notify", "visibility": "private" } },
  "remoteEnv": { "CLIPFORGE_DATA": "${containerWorkspaceFolder}/data" }
}
